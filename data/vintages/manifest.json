{
  "schema_version": 1,
  "series_start": "2026-08-05",
  "town_min_listings": 5,
  "point_in_time": "Each vintage is the town and province aggregates of public/data.json on the capture date: the last commit of that file in a closed ISO week, Monday to Sunday, UTC. The series starts on 2026-08-05. Commits before that date are not used. A day inside the declared capture gap is not a capture. The JSON file is written once, and a later run refuses to overwrite it. The manifest records the SHA-256 of those exact bytes. A day with no eligible capture is listed and left empty. Nothing is interpolated.",
  "definitions": {
    "live_listings": "Listings in the committed book on the capture date. A listing is one feed reference, not one dwelling.",
    "median_asking_eur_m2": "Median asking EUR per square metre on the capture date. A town median is published only when that town has at least 5 live listings and at least one positive asking EUR per square metre, the same floor as towns.csv. A province median is published when the province has at least one positive asking EUR per square metre. A thinner town has no median. No value is filled in from another day.",
    "price_cuts": "Same ref, same place, positive asking price on both vintages, and a lower asking price on the capture date. Null on the first vintage, when there is no previous file to compare.",
    "price_rises": "Same ref, same place, positive asking price on both vintages, and a higher asking price on the capture date. Null when there is no previous vintage.",
    "price_cut_share": "price_cuts divided by comparable listings, half-up to 4 decimal places, written as a decimal string. Comparable listings are the same ref in the same place with a positive asking price in both vintages. Null when there is no comparison, or when the comparable count is zero.",
    "price_rise_share": "price_rises divided by the same comparable count, in the same decimal form. Null on the same terms as the cut share.",
    "new_listings": "A ref in this place on the capture date that was not in the previous book. Null when there is no previous vintage.",
    "removed_listings": "A ref that was in this place in the previous vintage and is absent from the whole book on the capture date. Leaving the book is not a recorded sale. Null when there is no previous vintage.",
    "reassigned": "A ref present in both books whose town or province changed. It is not counted as new, removed, or a price move.",
    "gaps": "gap_dates_in_week are the days in that closed week, on or after the series start, that are not an eligible capture. A commit inside the declared capture gap is not eligible. Those days are listed and left empty."
  },
